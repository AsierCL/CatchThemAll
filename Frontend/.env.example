# Destino del proxy de Vite (vite dev y vite preview).
VITE_API_PROXY_TARGET=http://localhost:8080

# Base que usa Axios. En desarrollo se deja sin definir para usar el proxy /api.
# En un build estatico sin reescritura del servidor, definir una URL absoluta.
# VITE_API_BASE_URL=https://api.example.com

# Enlace opcional a Swagger. Si no se define, el footer no muestra el enlace.
# VITE_API_DOCS_URL=https://api.example.com/swagger-ui.html
